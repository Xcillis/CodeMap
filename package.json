{
  "name": "codemap-m1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": "npm test -- --maxWorkers=2 && npm run build",
    "build:pages": "npm run build:cloudflare",
    "deploy:cloudflare": "npm exec --yes --package=wrangler@4 -- wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "blockly": "^13.4.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^30.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
